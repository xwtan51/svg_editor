{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,

    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@svgframe/kernel": ["./packages/kernel/src/api.ts"],
      "@svgframe/kernel/host": ["./packages/kernel/src/host-api.ts"]
    },
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "packages/*/src",
    "packages/*/tests",
    "plugins/*/src",
    "plugins/*/tests",
    "vitest.config.ts"
  ]
}
